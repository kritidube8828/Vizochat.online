# Copy this file to .env and fill in real values before deploying to production

# PostgreSQL - REQUIRED. Data lives here independently of the app server,
# so it survives restarts/redeploys/crashes (unlike a local SQLite file on
# most hosting platforms, which gets wiped on every redeploy).
# Free managed options: https://neon.tech, https://supabase.com, https://railway.app
DATABASE_URL=postgresql://user:password@host:5432/vizochat
# Set to "disable" only for a local Postgres without SSL (e.g. localhost dev)
PGSSL=
# Connections per app instance. With N instances running, total connections
# to Postgres = N x PG_POOL_MAX - keep this within your DB provider's limit.
PG_POOL_MAX=20

PORT=4000

# JWT secret used to sign session tokens - CHANGE THIS to a long random string
JWT_SECRET=change_this_to_a_long_random_secret_string

# Redis - OPTIONAL, only needed once you run more than one server instance
# (see README "Scaling to 10,000 concurrent users"). Leave blank for a
# single-instance setup (fine up to a few hundred/low-thousands concurrent).
REDIS_URL=

# Google OAuth - REQUIRED. Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin must be your real domain, e.g. https://vizochat.online
# (use http://localhost:4000 as an extra authorized origin while testing locally)
GOOGLE_CLIENT_ID=

# Razorpay payment gateway - sign up at https://dashboard.razorpay.com/
# Use TEST mode keys (rzp_test_...) while developing - test payments are free and safe,
# and coins are credited automatically through the same real verification code path.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Found under Razorpay Dashboard > Settings > Webhooks after you create a webhook
# pointing to https://yourdomain.com/api/payments/webhook (event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=

# Rolling window (minutes) and report threshold for auto-ban
REPORT_WINDOW_MINUTES=60
REPORT_BAN_THRESHOLD=5
BAN_DURATION_DAYS=21

# Coins <-> money withdrawal rate (coins per $1) - adjust to your real rate
EARNED_COINS_PER_DOLLAR=307
